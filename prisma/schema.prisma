datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notice {
  id             String    @id @default(cuid())
  userId         String?
  title          String
  body           String    @db.Text
  category       String // "placement" | "exam" | "event" | "hostel" | "general"
  eventDate      DateTime?
  venue          String?
  actionRequired String?
  source         String?
  embedding      Json
  instituteName  String?
  major          String?
  createdAt      DateTime  @default(now())
}

model MessMenu {
  id            String   @id @default(cuid())
  userId        String?
  day           String // "Monday" | "Tuesday" | ... | "Sunday"
  meal          String // "breakfast" | "lunch" | "dinner"
  items         String   @db.Text // comma-separated list of dishes
  isVeg         Boolean  @default(true)
  embedding     Json
  instituteName String?
  major         String?
  createdAt     DateTime @default(now())
}

model Deadline {
  id            String   @id @default(cuid())
  title         String
  subject       String
  dueDate       DateTime
  userId        String?
  type          String // "exam" | "assignment" | "project" | "other"
  isComplete    Boolean  @default(false)
  notes         String?
  embedding     Json
  instituteName String?
  major         String?
  createdAt     DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model ClassSchedule {
  id            String   @id @default(cuid())
  day           String // "Monday" | "Tuesday" | ... | "Sunday"
  subject       String
  userId        String?
  startTime     String // 24hr format "HH:MM" e.g. "09:00"
  endTime       String // 24hr format "HH:MM" e.g. "10:00"
  room          String?
  faculty       String?
  embedding     Json
  instituteName String?
  major         String?
  createdAt     DateTime @default(now())
}

model StudyPlan {
  id          String   @id @default(cuid())
  deadlineId  String // references Deadline.id — no enforced FK
  userId      String?
  title       String
  planText    String   @db.Text // day-by-day plan as markdown
  generatedAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  userId      String?
  amount      Float
  category    String // "food", "travel", "academics", "rent",
  // "subscriptions", "entertainment", "other"
  description String
  date        DateTime @default(now())
  source      String // "manual", "receipt", "sms"
  embedding   Json
  createdAt   DateTime @default(now())
}

model Budget {
  id             String   @id @default(cuid())
  userId         String?
  month          String // "2026-06" format
  totalLimit     Float
  categoryLimits Json // { food: 3000, travel: 1000, ... }
  createdAt      DateTime @default(now())
}

model WellnessLog {
  id            String   @id @default(cuid())
  userId        String?
  date          DateTime @default(now())
  mood          Int
  sleepHours    Float?
  stressLevel   Int
  notes         String?  @db.Text
  embedding     Json?
  instituteName String?
  major         String?
  createdAt     DateTime @default(now())
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String?
  instituteName   String?
  major           String?
  gradYear        Int?
  gender          String?
  profileComplete Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Phase 11 fields
  branch          String?
  year            Int?
  whatsappNumber  String?
  contactOptIn    Boolean  @default(false)
  onboardingDone  Boolean  @default(false)

  // Phase 15 fields
  lastEmailSync     DateTime?
  emailSyncEnabled  Boolean   @default(false)

  // Reputation fields — computed, never manually set
  totalHelped       Int      @default(0)
  totalRequested    Int      @default(0)
  reputationScore   Float    @default(0)
  responseRate      Float    @default(1.0)
  avgRating         Float?
}

model WellnessInsight {
  id          String   @id @default(cuid())
  userId      String?
  date        DateTime @default(now())
  score       Int
  message     String   @db.Text
  createdAt   DateTime @default(now())
}

model ExpertiseSeed {
  id          String   @id @default(cuid())
  profileId   String
  topic       String
  source      String
  confidence  Int      @default(1)
  embedding   Json
  createdAt   DateTime @default(now())

  @@unique([profileId, topic, source])
}

model HelpRequest {
  id            String   @id @default(cuid())
  requesterId   String   // UserProfile.id
  topic         String
  description   String?  @db.Text
  urgency       String   @default("normal")
  // "low" | "normal" | "high"
  isAnonymous   Boolean  @default(false)
  status        String   @default("open")
  // "open" | "selecting" | "matched" | "scheduled" | "completed" | "cancelled" | "expired"
  embedding     Json
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  volunteers    HelpVolunteer[]
  studySession  StudySession?
}

model HelpVolunteer {
  id              String    @id @default(cuid())
  requestId       String    // HelpRequest.id
  request         HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  helperId        String    // UserProfile.id
  status          String    @default("volunteered")
  // "volunteered" | "selected" | "not_selected" | "withdrawn"
  message         String?
  notifiedAt      DateTime  @default(now())
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([requestId, helperId])
}

model StudySession {
  id              String    @id @default(cuid())
  requestId       String    @unique
  request         HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requesterId     String    // UserProfile.id
  helperId        String    // UserProfile.id
  topic           String
  status          String    @default("pending_schedule")
  // "pending_schedule" | "confirmed" | "completed" | "cancelled" | "no_show"

  proposedSlots        Json
  requesterSlotChoice  Int?
  helperSlotChoice     Int?
  agreedSlot           Json?
  confirmedAt          DateTime?
  scheduledFor         DateTime?
  contactShared        Boolean   @default(false)

  completedAt          DateTime?
  requesterRating      Int?
  requesterReview      String?
  helperRating         Int?
  helperReview         String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PeerNotification {
  id          String   @id @default(cuid())
  profileId   String   // UserProfile.id
  type        String
  // "help_needed" | "volunteer_list_ready" | "you_were_selected"
  // "slots_proposed" | "session_confirmed" | "contact_revealed"
  // "session_reminder" | "rate_your_session" | "request_cancelled" | "request_expired"
  referenceId String
  message     String
  actionUrl   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmailSyncLog {
  id              String   @id @default(cuid())
  profileId       String?  // null for cron-triggered syncs before profile load
  triggeredBy     String   // "cron" | "chat" | "manual_api"
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("running")
  // "running" | "completed" | "failed" | "partial"
  emailsFound     Int      @default(0)
  emailsProcessed Int      @default(0)
  emailsSkipped   Int      @default(0)
  // skipped = private/irrelevant, deduplicated, or over cap
  noticesCreated  Int      @default(0)
  deadlinesCreated Int     @default(0)
  schedulesUpdated Int     @default(0)
  errorMessage    String?  @db.Text
  // if status="failed", why
  extractionLog   Json     @default("[]")
  // array of { emailId, subject, decision, entityType, confidence, reason }
  // populated even for skipped emails — this is your audit trail
}

model ProcessedEmail {
  id          String   @id @default(cuid())
  gmailId     String   @unique
  // Gmail's internal message ID — globally unique per message
  subject     String
  receivedAt  DateTime
  profileId   String
  syncLogId   String
  wasPrivate  Boolean
  // true = privacy filter caught it (stored for audit, no content)
  createdAt   DateTime @default(now())

  @@index([profileId, receivedAt])
}

// ────────────────────────────────────────
// Phase 15 — Company Profiles + Interview Experience Bank
// ────────────────────────────────────────

model Company {
  id                String   @id @default(cuid())
  instituteName     String
  name              String
  domain            String
  // "tech" | "finance" | "consulting" | "core" | "product" | "other"
  packageMin        Float?   // in LPA
  packageMax        Float?   // in LPA
  interviewRounds   Int?
  roundDescriptions Json?
  // ["Online Assessment", "Technical Round 1", "HR Round"]
  topSkillsRequired Json
  // ["DSA", "System Design", "SQL"] — used for skill gap analysis
  campusVisitCount  Int      @default(0)
  // how many times this company has visited this campus
  lastVisitedYear   Int?
  description       String?  @db.Text
  websiteUrl        String?
  addedBy           String?  // userId of who added this company
  reportCount       Int      @default(0)
  embedding         Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InterviewExperience {
  id             String   @id @default(cuid())
  instituteName  String
  companyId      String
  userId         String?
  studentName    String?
  // null if isAnonymous=true
  batch          String
  // "2024", "2025" — year of placement
  branch         String
  outcome        String
  // "selected" | "rejected_r1" | "rejected_r2" | "rejected_hr" | "offer_declined"
  packageOffered Float?
  // only if outcome="selected" and student chose to share
  rounds         Json
  // array of { roundName, duration, questions: string[], tips: string }
  overallTips    String   @db.Text
  isAnonymous    Boolean  @default(true)
  isVerified     Boolean  @default(false)
  // placement cell can verify authenticity
  upvotes        Int      @default(0)
  embedding      Json
  // embed: companyName + branch + outcome + overallTips
  createdAt      DateTime @default(now())
}

model PrepQuestion {
  id          String   @id @default(cuid())
  instituteName String
  companyId   String
  round       String
  // "oa" | "technical" | "hr" | "managerial" | "case_study"
  question    String   @db.Text
  answer      String?  @db.Text
  // community-contributed answer, optional
  difficulty  String   @default("medium")
  // "easy" | "medium" | "hard"
  tags        Json     @default("[]")
  // ["arrays", "dp", "graphs"] — custom user tags
  link        String?  // optional URL reference
  upvotes     Int      @default(0)
  submittedBy String?
  // userId of contributor
  isVerified  Boolean  @default(false)
  embedding   Json
  createdAt   DateTime @default(now())
}

model CompanyReport {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
}

model SkillGapAnalysis {
  id           String   @id @default(cuid())
  userId       String
  companyId    String
  gaps         Json
  // [{ skill: "System Design", status: "missing"|"weak"|"strong", priority: 1 }]
  peerMatchIds Json
  // [userId] — peers who can help close each gap
  generatedAt  DateTime @default(now())
  expiresAt    DateTime
  // regenerate after 7 days or after new expertise signals

  @@unique([userId, companyId])
}

// ────────────────────────────────────────
// Phase 16 — AI Prep Guides + Personalized Plans
// ────────────────────────────────────────

model CompanyPrepGuide {
  id            String   @id @default(cuid())
  instituteName String
  companyId     String   @unique
  synthesisText String   @db.Text
  keyThemes     Json
  doList        Json
  dontList      Json
  generatedAt   DateTime @default(now())
  basedOnCount  Int
}

model PersonalizedPrepPlan {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  daysUntilDrive  Int
  planText        String   @db.Text
  skillGapIds     Json
  generatedAt     DateTime @default(now())

  @@unique([userId, companyId])
}

// ────────────────────────────────────────
// Phase 17 — Transport Intelligence
// ────────────────────────────────────────

model TransportRoute {
  id            String   @id @default(cuid())
  instituteName String
  name          String
  type          String
  // "bus" | "shuttle" | "auto_stand" | "cab_point"
  stops         Json
  // [{ name: "Main Gate", time: "08:45" }, ...]
  operatingDays Json
  // ["Monday", "Tuesday", ...] or ["Weekdays"] or ["All"]
  frequency     String?
  notes         String?
  isActive      Boolean  @default(true)
  embedding     Json
  createdAt     DateTime @default(now())
}

model TransportUpdate {
  id          String   @id @default(cuid())
  instituteName String
  routeId     String?
  updateType  String
  // "delay" | "cancelled" | "full" | "early" | "general"
  message     String
  reportedBy  String
  severity    String   @default("info")
  // "info" | "warning" | "critical"
  expiresAt   DateTime
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
}

model CabPoolRequest {
  id             String   @id @default(cuid())
  instituteName  String
  initiatorId    String
  source         String?
  destination    String
  departureTime  DateTime
  seatsAvailable Int
  estimatedCost  Float?
  participants   Json
  // [userId, ...]
  pendingRequests Json?   @default("[]")
  // [{userId, status: "pending" | "rejected"}]
  status         String   @default("open")
  // "open" | "full" | "departed" | "cancelled"
  notes          String?
  createdAt      DateTime @default(now())
}

// ────────────────────────────────────────
// Phase 18 — Campus Services Directory
// ────────────────────────────────────────

model CampusService {
  id              String    @id @default(cuid())
  instituteName   String
  name            String
  category        String
  // "academic" | "admin" | "hostel" | "library" | "medical" | "sports" | "other"
  location        String
  timings         Json
  // [{ days: "Monday-Friday", hours: "10:00-17:00" }]
  contactEmail    String?
  contactPhone    String?
  currentStatus   String    @default("unknown")
  // "open" | "closed" | "crowded" | "unknown"
  statusUpdatedAt DateTime?
  statusUpdatedBy String?
  embedding       Json
  createdAt       DateTime  @default(now())
}

model ProcessGuide {
  id                String   @id @default(cuid())
  instituteName     String
  serviceId         String
  title             String
  steps             Json
  // [{ order: 1, instruction: "Go to Room 102 with your ID" }]
  documentsRequired Json
  estimatedDays     Int
  fees              Float?
  tips              String?  @db.Text
  submittedBy       String?
  upvotes           Int      @default(0)
  isVerified        Boolean  @default(false)
  embedding         Json
  createdAt         DateTime @default(now())
}

// ────────────────────────────────────────
// Phase 19 — Food Intelligence
// ────────────────────────────────────────

model MealRating {
  id         String   @id @default(cuid())
  messMenuId String
  userId     String
  rating     Int      // 1-5 stars
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([messMenuId, userId])
}

model NutritionEstimate {
  id         String   @id @default(cuid())
  instituteName String
  messMenuId String   @unique
  calories   Int
  proteinG   Float
  carbsG     Float
  fatG       Float
  fibreG     Float?
  isEstimated Boolean @default(true)
  generatedAt DateTime @default(now())
}

model CanteenItem {
  id          String   @id @default(cuid())
  instituteName String
  canteenName String
  itemName    String
  price       Float
  category    String
  // "snack" | "meal" | "beverage" | "dessert"
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  rating      Float?
  embedding   Json
  createdAt   DateTime @default(now())
}

model GroupOrder {
  id               String   @id @default(cuid())
  instituteName    String
  initiatorId      String
  platform         String
  // "swiggy" | "zomato" | "direct" | "other"
  restaurantName   String
  orderDeadline    DateTime
  deliveryLocation String
  participants     Json
  // [{ userId, items: string, amount: number }]
  status           String   @default("open")
  // "open" | "placed" | "delivered" | "cancelled"
  totalAmount      Float?
  notes            String?
  createdAt        DateTime @default(now())
}

// ────────────────────────────────────────
// Phase 20 — Local Discovery + Survival Guide
// ────────────────────────────────────────

model LocalPlace {
  id             String   @id @default(cuid())
  instituteName  String
  name           String
  category       String
  // "food" | "stationery" | "medical" | "atm" | "salon" | "gym" | "entertainment" | "emergency" | "other"
  distanceMeters Int?
  direction      String?
  description    String   @db.Text
  priceRange     String?
  timings        String?
  phone          String?
  mustTry        String?
  submittedBy    String
  upvotes        Int      @default(0)
  isVerified     Boolean  @default(false)
  embedding      Json
  createdAt      DateTime @default(now())
}

model TripRecommendation {
  id            String   @id @default(cuid())
  instituteName String
  destination   String
  distanceKm    Int
  estimatedCost Float
  howToGet      String   @db.Text
  bestFor       String
  // "day_trip" | "weekend" | "evening"
  bestSeason    String?
  highlights    Json
  // ["waterfall", "street food", "temple"]
  submittedBy   String
  upvotes       Int      @default(0)
  embedding     Json
  createdAt     DateTime @default(now())
}

model SurvivalTip {
  id          String   @id @default(cuid())
  instituteName String
  category    String
  // "fresher" | "hostel" | "food" | "academic" | "money" | "health" | "social" | "general"
  title       String
  tip         String   @db.Text
  submittedBy String
  upvotes     Int      @default(0)
  isVerified  Boolean  @default(false)
  embedding   Json
  createdAt   DateTime @default(now())
}


model Note {
  id            String   @id @default(cuid())
  userId        String?
  title         String
  content       String   @db.Text
  subject       String
  fileName      String?
  fileUrl       String?  @db.LongText
  embedding     Json?
  instituteName String?
  major         String?
  createdAt     DateTime @default(now())
}
